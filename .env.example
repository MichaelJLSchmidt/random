# Copy to .env.local for `npm run build:server && npm start`.
# Password for the pre-launch gate. While SITE_GATE is not "off" and this is
# empty, nobody can get in (the gate fails closed).
SITE_PASSWORD=
# Set to "off" at launch to remove the gate and allow indexing.
SITE_GATE=on
# MOTION_TOKEN must be exported in the shell for `npm install` (npm does not read .env files).
