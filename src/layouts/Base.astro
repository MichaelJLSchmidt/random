---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import InkSweep from '../generated/brush/InkSweep.astro';
import { tokensCss } from '../design/tokens';
import { site } from '../config/site';
import fallbacks from '../generated/fonts.json';
// Self-hosted variable WOFF2 (Fontsource). Imported as URLs so they carry the base path.
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import instrumentUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Pages that show the seal in their opening viewport. */
  sealPage?: boolean;
  page?: string;
}
const { title, description = site.description, sealPage = false, page = 'page' } = Astro.props;
const fullTitle = title ? `${title} · ${site.title}` : `${site.title}: ${site.role}`;
const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const face = (family: string, src: string, weight: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:${weight};src:url(${src}) format('woff2');unicode-range:${LATIN}}`;
const fontCss =
  face('Fraunces Variable', frauncesUrl, '100 900') +
  face('Instrument Sans Variable', instrumentUrl, '400 700') +
  face('JetBrains Mono Variable', monoUrl, '100 800') +
  fallbacks
    .map(
      (f) =>
        `@font-face{font-family:'${f.name}';src:local('${f.local}');size-adjust:${f.sizeAdjust};ascent-override:${f.ascentOverride};descent-override:${f.descentOverride};line-gap-override:${f.lineGapOverride}}`,
    )
    .join('');
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#F4EFE6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14130F" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    <!-- Motion tier before first paint: Full | Calm | Still (reduced motion → Calm). -->
    <script is:inline>
      (() => {
        const d = document.documentElement;
        let t = null;
        try {
          t = localStorage.getItem('inkwake:motion');
        } catch (e) {}
        if (!/^(full|calm|still)$/.test(t || '')) t = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'calm' : 'full';
        d.dataset.motion = t;
        let seen = '1';
        try {
          seen = sessionStorage.getItem('inkwake:intro');
        } catch (e) {}
        if (!seen && t === 'full') d.dataset.intro = 'play';
        document.addEventListener('astro:before-swap', (e) => {
          e.newDocument.documentElement.dataset.motion = d.dataset.motion;
        });
      })();
    </script>
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={tokensCss() + fontCss}></style>
    <ClientRouter />
  </head>
  <body data-page={page} data-seal-page={sealPage ? '' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Intro />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <div class="page-sweep" aria-hidden="true" transition:persist="page-sweep" data-page-sweep>
      <InkSweep anim="manual" decorative idPrefix="sweep" />
      <div class="solid"></div>
    </div>
    <div class="page-fade" aria-hidden="true" transition:persist="page-fade" data-page-fade></div>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="ink-settle" x="-15%" y="-15%" width="130%" height="130%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.08" numOctaves="2" seed="7" result="n"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="n" scale="0" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
      </filter>
    </svg>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
