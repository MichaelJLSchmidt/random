---
// /system: the living art-direction spec, used to evaluate the direction.
import Base from '../layouts/Base.astro';
import Seal from '../components/Seal.astro';
import SpotOpenLoop from '../generated/brush/SpotOpenLoop.astro';
import Specimen from '../generated/brush/Specimen.astro';
import SpecimenClean from '../generated/brush/SpecimenClean.astro';
import manifest from '../generated/brush/manifest.json';
import { color, textPairs, contrast, duration, ease, cubic, type, type ColorName } from '../design/tokens';
import { BRUSHES } from '../../brush/presets.mjs';

const names = Object.keys(color.light) as ColorName[];
const roles: Record<ColorName, string> = {
  paper: 'Background',
  'paper-deep': 'Cards, mats, alternate sections',
  ink: 'Primary strokes, body text',
  'ink-wash': 'Secondary text, captions, dry brush',
  graphite: 'Decorative strokes only, never text',
  indigo: 'Links, focus rings, one accent layer',
  seal: 'Seal, active states, large display only',
  'seal-text': 'Vermilion as small text',
  moss: 'Rare botanical accent, max one per page',
};
const verdict = (r: number, large?: boolean) => (r >= 4.5 ? 'AA' : r >= 3 && large ? 'AA large' : 'Fail');
const pairs = textPairs.map((p) => {
  const light = contrast(color.light[p.fg], color.light[p.bg]);
  const dark = contrast(color.dark[p.fg], color.dark[p.bg]);
  return { ...p, light, dark, lv: verdict(light, p.large), dv: verdict(dark, p.large) };
});
const specimenLine = manifest.find((m) => m.id === 'specimen')!.centrelines![0];
const strokeTotal = manifest.reduce((a, m) => a + m.strokes, 0);
const curve = (e: readonly number[]) => `M0 40 C${e[0] * 80} ${40 - e[1] * 40} ${e[2] * 80} ${40 - e[3] * 40} 80 0`;
const maxDur = Math.max(...Object.values(duration));
---
<Base title="System" page="system" sealPage>
  <div data-system>
    <section class="section sys-open" data-opening>
      <div class="wrap grid">
        <div class="col-text">
          <p class="eyebrow" data-rise>Art direction · living spec</p>
          <h1 data-split>INKWAKE</h1>
          <p class="lede" data-rise>
            Every section is drawn into being by one confident brush stroke, which leaves a quiet wake of ink behind it. Sketch, then
            structure, then system.
          </p>
          <ul class="tags caption" data-rise>
            {['calm', 'deliberate', 'tactile', 'warm', 'editorial', 'precise, with a human hand'].map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <figure class="col-art sys-loop">
          <SpotOpenLoop anim="load" decorative idPrefix="sys-loop" />
        </figure>
      </div>
    </section>

    <section class="section" aria-labelledby="ratio-h" style="padding-top:0">
      <div class="wrap grid">
        <h2 id="ratio-h" class="col-text" data-split>Ratio</h2>
        <div class="col-wide" data-rise>
          <div class="ratio" role="img" aria-label="80 percent paper and air, 15 percent ink, 5 percent vermilion seal">
            <span style="flex:80" class="r-paper">80% paper and air</span>
            <span style="flex:15" class="r-ink">15% ink</span>
            <span style="flex:5" class="r-seal"></span>
          </div>
          <p class="caption" style="margin-top:12px">Vermilion appears at most once per viewport. Illustrations use ink, wash and at most one accent. Avoid: splashy, grungy, chaotic, cute, and any cultural pastiche. Brush and ink are a technique, not a costume.</p>
        </div>
      </div>
    </section>

    <section class="section section--deep" aria-labelledby="palette-h">
      <div class="wrap">
        <h2 id="palette-h" data-split>Palette</h2>
        <ul class="swatches" data-rise>
          {
            names.map((n) => (
              <li>
                <span class="chip" style={`--c:var(--${n})`} />
                <code class="caption">--{n}</code>
                <span class="caption swatch-hex">
                  {color.light[n]} · {color.dark[n]}
                </span>
                <span class="swatch-role">{roles[n]}</span>
              </li>
            ))
          }
        </ul>
        <h3 class="sub" data-rise>Measured contrast (WCAG 2.2)</h3>
        <div class="table-wrap" data-rise>
          <table class="contrast">
            <thead>
              <tr>
                <th scope="col">Pair</th>
                <th scope="col">Use</th>
                <th scope="col">Light</th>
                <th scope="col">Dark</th>
              </tr>
            </thead>
            <tbody>
              {
                pairs.map((p) => (
                  <tr>
                    <td>
                      <code>
                        {p.fg} / {p.bg}
                      </code>
                    </td>
                    <td>{p.use}</td>
                    <td>
                      {p.light.toFixed(2)}:1 <span class="verdict">{p.lv}</span>
                    </td>
                    <td>
                      {p.dark.toFixed(2)}:1 <span class="verdict">{p.dv}</span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="caption-deep" data-rise>
          --ink-wash on --paper-deep is {contrast(color.light['ink-wash'], color.light['paper-deep']).toFixed(2)}:1 in light mode, so small text on deep surfaces uses --ink. --graphite and --moss are never used for text.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="type-h">
      <div class="wrap">
        <h2 id="type-h" data-split>Type</h2>
        <div class="axes" data-axes data-rise>
          <p class="axes-text" data-axes-text aria-label="Fraunces specimen">Sketch → system</p>
          <div class="axes-controls">
            {
              [
                { n: 'opsz', min: 9, max: 144, v: 144 },
                { n: 'wght', min: 100, max: 900, v: 380 },
                { n: 'SOFT', min: 0, max: 100, v: 50 },
                { n: 'WONK', min: 0, max: 1, v: 0, step: 1 },
              ].map((a) => (
                <label class="caption">
                  <span>{a.n}</span>
                  <input type="range" id={`ax-${a.n}`} name={a.n} min={a.min} max={a.max} step={a.step ?? 1} value={a.v} />
                  <output for={`ax-${a.n}`}>{a.v}</output>
                </label>
              ))
            }
            <button class="btn" type="button" data-axes-play>Play the axes</button>
          </div>
        </div>
        <div class="type-grid">
          <div data-rise>
            <p class="eyebrow">Display · Fraunces</p>
            <p class="t-display">Aa</p>
            <p class="caption">clamp({type.display.replace('clamp(', '').replace(')', '')}) · opsz / wght / SOFT / WONK</p>
          </div>
          <div data-rise>
            <p class="eyebrow">Text · Instrument Sans</p>
            <p>Body at {type.body} / {type.bodyLine}. Calm, legible and unadorned, so the brushwork can carry the voice.</p>
            <p class="caption">h2 {type.h2}</p>
          </div>
          <div data-rise>
            <p class="eyebrow">Notes · JetBrains Mono</p>
            <p class="mono">−32% task time · 12 sessions · v2.4</p>
            <p class="caption">Captions {type.caption} mono. Annotations, metrics and process notes.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--deep" aria-labelledby="motion-h">
      <div class="wrap">
        <h2 id="motion-h" data-split>Motion tokens</h2>
        <div class="motion-grid">
          <table class="tokens" data-rise>
            <caption class="eyebrow">Durations</caption>
            <tbody>
              {
                Object.entries(duration).map(([k, v]) => (
                  <tr>
                    <th scope="row">
                      <code>--dur-{k}</code>
                    </th>
                    <td class="mono">{v}ms</td>
                    <td class="bar-cell">
                      <span class="bar" style={`width:${(v / maxDur) * 100}%`} />
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <ul class="eases" data-rise>
            {
              Object.entries(ease).map(([k, v]) => (
                <li data-ease-demo data-ease={k} data-duration={k === 'wipe' ? 900 : 1100}>
                  <svg viewBox="-2 -2 84 44" class="curve" aria-hidden="true">
                    <path d={curve(v)} />
                  </svg>
                  <span>
                    <code>--ease-{k}</code>
                    <span class="caption-deep">{cubic(v)}</span>
                  </span>
                  <span class="ease-track">
                    <span class="ease-dot" />
                  </span>
                  <button type="button" class="btn btn--quiet">
                    Play<span class="sr-only"> {k} easing</span>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="brush-h">
      <div class="wrap">
        <h2 id="brush-h" data-split>Brush system</h2>
        <p class="lede" data-rise>
          {manifest.length} illustrations, {strokeTotal} strokes. Centrelines are authored as data; perfect-freehand builds each brush outline at build
          time; every stroke is masked by its own centreline and drawn in order.
        </p>
        <ul class="presets" data-rise>
          {
            Object.values(BRUSHES).map((b) => (
              <li>
                <h3>{b.label}</h3>
                <p>{b.use}</p>
                <p class="caption-deep">
                  thinning {b.thinning} · smoothing {b.smoothing} · streamline {b.streamline} · end taper {Math.round(b.endTaper * 100)}%
                  {b.bristles ? ` · ${b.bristles.count} bristles` : ''}
                </p>
              </li>
            ))
          }
        </ul>

        <h3 class="sub" data-rise>Technique specimens</h3>
        <ol class="specimens">
          <li data-specimen="dash" data-own>
            <svg viewBox="0 0 320 160" class="spec-svg" aria-hidden="true">
              <path d={specimenLine} fill="none" stroke="currentColor" stroke-width="10" stroke-linecap="round"></path>
            </svg>
            <p><strong>1. Plain dashoffset line</strong><span class="caption">Uniform width. Mechanical.</span></p>
            <button type="button" class="btn btn--quiet" data-replay>Replay</button>
          </li>
          <li data-specimen="mask" data-own>
            <SpecimenClean anim="manual" idPrefix="sp-mask" />
            <p><strong>2. Centreline mask over a filled brush</strong><span class="caption">Pooled entry, thinning, tapered exit.</span></p>
            <button type="button" class="btn btn--quiet" data-replay>Replay</button>
          </li>
          <li data-specimen="grain" data-own>
            <div class="ink-grain"><Specimen anim="manual" idPrefix="sp-grain" /></div>
            <p><strong>3. Mask + grain</strong><span class="caption">The grain breaks the edge into dry brush.</span></p>
            <button type="button" class="btn btn--quiet" data-replay>Replay</button>
          </li>
          <li data-specimen="settle" data-own>
            <div class="ink-grain"><Specimen anim="manual" idPrefix="sp-settle" /></div>
            <p><strong>4. Mask + settle filter</strong><span class="caption">One-shot displacement 3 → 0 in 400 ms, then removed.</span></p>
            <button type="button" class="btn btn--quiet" data-replay>Replay</button>
          </li>
          <li data-specimen="bloom" data-own>
            <div class="ink-grain bloom-host"><Specimen anim="manual" idPrefix="sp-bloom" /></div>
            <p><strong>5. Shader bloom</strong><span class="caption" data-gate>Checking the gate…</span></p>
            <button type="button" class="btn btn--quiet" data-replay>Replay</button>
          </li>
        </ol>

        <h3 class="sub" data-rise>Illustrations</h3>
        <div class="table-wrap" data-rise>
          <table class="manifest">
            <thead>
              <tr><th scope="col">Id</th><th scope="col">Kind</th><th scope="col">Strokes</th><th scope="col">Brushes</th><th scope="col">Negative space</th><th scope="col">Draw</th><th scope="col">Source</th></tr>
            </thead>
            <tbody>
              {
                manifest.map((m) => (
                  <tr>
                    <td><code>{m.id}</code></td>
                    <td>{m.kind}</td>
                    <td class="mono">{m.strokes}</td>
                    <td>{m.brushes.join(', ')}</td>
                    <td class="mono">{m.kind === 'ui' ? 'n/a' : `${Math.round(m.negativeSpace * 100)}%`}</td>
                    <td class="mono">{m.total ? `${m.total}ms` : 'n/a'}</td>
                    <td>{m.source}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section section--deep" aria-labelledby="seal-h">
      <div class="wrap grid">
        <div class="col-text">
          <h2 id="seal-h" data-split>Seal</h2>
          <p data-rise>A square vermilion stamp with a neutral placeholder monogram. It stamps (scale 1.04 → 1 in 160 ms) and settles once. One per viewport.</p>
        </div>
        <div class="col-art seal-spec" data-rise><Seal size="120px" label="Seal specimen" /></div>
      </div>
    </section>
  </div>
</Base>

<style>
  .sys-open {
    padding-top: clamp(24px, 4vw, 64px);
  }
  .sys-open .grid {
    align-items: center;
  }
  .sys-open .lede {
    margin-top: 24px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 4px 10px;
    border: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
    border-radius: 99px;
  }
  .sys-loop {
    margin: 0;
    width: min(100%, 300px);
    justify-self: end;
  }
  .ratio {
    display: flex;
    height: 72px;
    margin-top: 32px;
    border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
  }
  .ratio span {
    display: flex;
    align-items: end;
    padding: 8px 10px;
    overflow: hidden;
    white-space: nowrap;
  }
  .r-paper {
    background: var(--paper);
  }
  .r-ink {
    background: var(--ink);
    color: var(--paper);
  }
  .r-seal {
    background: var(--seal);
  }
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 28px var(--gutter);
    margin-top: 40px;
    padding: 0;
    list-style: none;
  }
  .swatches li {
    display: grid;
    gap: 4px;
  }
  .chip {
    display: block;
    height: 72px;
    margin-bottom: 8px;
    background: var(--c);
    border: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
    border-radius: 2px;
  }
  .swatch-hex,
  .swatches code,
  .caption-deep {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
  }
  .swatch-role {
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .sub {
    margin-top: 72px;
    margin-bottom: 20px;
  }
  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  th,
  td {
    text-align: left;
    padding: 10px 12px 10px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    vertical-align: top;
  }
  thead th {
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    font-weight: 500;
  }
  code {
    font-family: var(--font-mono);
    font-size: 0.875em;
  }
  .verdict {
    display: inline-block;
    margin-left: 6px;
    padding: 0 6px;
    border: 1px solid currentColor;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .caption-deep {
    margin-top: 16px;
  }
  .axes {
    margin-top: 40px;
  }
  .axes-text {
    --opsz: 144;
    --wght: 380;
    --SOFT: 50;
    --WONK: 0;
    max-width: none;
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 9rem);
    line-height: 1.05;
    height: 1.15em;
    white-space: nowrap;
    overflow: hidden;
    font-variation-settings:
      'opsz' var(--opsz),
      'wght' var(--wght),
      'SOFT' var(--SOFT),
      'WONK' var(--WONK);
  }
  .axes-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 20px;
  }
  .axes-controls label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .axes-controls input {
    width: 140px;
    accent-color: var(--indigo);
  }
  .axes-controls output {
    min-width: 3ch;
  }
  .type-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 40px var(--gutter);
    margin-top: 64px;
  }
  .type-grid p + p {
    margin-top: 10px;
  }
  .t-display {
    font-family: var(--font-display);
    font-size: clamp(4rem, 8vw, 7rem);
    line-height: 1;
    font-variation-settings: 'SOFT' 100;
  }
  .motion-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 48px var(--gutter);
    margin-top: 40px;
  }
  .tokens caption {
    text-align: left;
    margin-bottom: 8px;
    color: var(--ink);
  }
  .bar-cell {
    width: 45%;
  }
  .bar {
    display: block;
    height: 6px;
    margin-top: 8px;
    background: var(--ink);
    border-radius: 3px;
  }
  .eases {
    display: grid;
    gap: 20px;
    padding: 0;
    list-style: none;
  }
  .eases li {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 8px 16px;
    align-items: center;
  }
  .eases li > span:nth-child(2) {
    display: grid;
  }
  .curve {
    width: 64px;
    overflow: visible;
  }
  .curve path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .ease-track {
    grid-column: 1 / -1;
    position: relative;
    display: block;
    height: 14px;
    border-bottom: 1px dashed color-mix(in srgb, var(--ink) 25%, transparent);
  }
  .ease-dot {
    position: absolute;
    left: 0;
    top: 2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--indigo);
  }
  .eases .btn {
    grid-column: 1 / -1;
    justify-self: start;
    min-height: 40px;
    padding: 8px 16px;
  }
  .presets {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 32px var(--gutter);
    margin-top: 40px;
    padding: 0;
    list-style: none;
  }
  .presets p {
    margin-top: 8px;
  }
  .specimens {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 40px var(--gutter);
    padding: 0;
    list-style: none;
  }
  .specimens li {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 20px;
    background: var(--paper-deep);
    border-radius: 2px;
  }
  .specimens strong {
    display: block;
    font-weight: 560;
  }
  .specimens .caption {
    display: block;
    color: var(--ink);
  }
  .specimens .btn {
    justify-self: start;
    min-height: 40px;
    padding: 8px 16px;
  }
  .spec-svg {
    color: var(--ink);
    overflow: visible;
  }
  .bloom-host {
    position: relative;
  }
  .seal-spec {
    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>
