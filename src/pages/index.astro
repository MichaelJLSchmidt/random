---
import Base from '../layouts/Base.astro';
import Hero from '../generated/brush/Hero.astro';
import SignatureStroke from '../generated/brush/SignatureStroke.astro';
import WorkList from '../components/WorkList.astro';
import Icon from '../components/Icon.astro';
import { home, site } from '../config/site';
import { url } from '../lib/url';
const words = home.headline;
---
<Base page="home">
  <section class="hero" data-hero data-opening data-own>
    <div class="wrap grid hero-grid">
      <div class="col-text hero-copy">
        <p class="eyebrow">{site.role}</p>
        <h1 class="hero-title">
          {words.slice(0, -1).join(' ')}{' '}
          <span class="sig-word">
            {home.signatureWord}
            <span class="sig-stroke" data-split-ignore aria-hidden="true">
              <SignatureStroke anim="manual" decorative />
            </span>
          </span>
        </h1>
        <p class="lede" data-rise>{home.lede}</p>
        <p class="hero-actions" data-rise>
          <a class="btn" href={url('work/')}>See the work</a>
          <a class="btn btn--quiet" href={url('contact/')}>Say hello</a>
        </p>
      </div>
      <figure class="col-art col-art--bleed hero-art">
        <Hero anim="manual" />
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="work-h">
    <div class="wrap">
      <div class="grid section-head">
        <p class="eyebrow col-wide" data-rise>Selected work</p>
        <h2 id="work-h" class="col-wide" data-split>Three projects, each with its own object.</h2>
      </div>
      <WorkList />
    </div>
  </section>

  <section class="section section--deep" aria-labelledby="approach-h">
    <div class="wrap grid">
      <h2 id="approach-h" class="col-wide" data-split>Sketch, then structure, then system.</h2>
      <ol class="approach col-wide">
        {
          home.approach.map((a, i) => (
            <li data-rise>
              <span class="approach-icon">
                <Icon name={a.icon} anim="scroll" idPrefix={`approach-${i}`} />
              </span>
              <h3>{a.step}</h3>
              <p class="muted-deep">{a.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--lg" aria-labelledby="hello-h">
    <div class="wrap grid">
      <div class="col-text">
        <h2 id="hello-h" class="display" data-split>Say hello.</h2>
        <p class="lede" data-rise>Placeholder invitation to get in touch about design leadership and product work.</p>
        <p data-rise><a class="btn" href={url('contact/')}>Contact</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(24px, 4vw, 64px) var(--space-section);
  }
  .hero-grid {
    align-items: center;
    row-gap: 48px;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
  }
  .hero-title {
    --soft: 100;
    --wonk: 0;
    margin-top: 20px;
    font-variation-settings:
      'SOFT' var(--soft),
      'WONK' var(--wonk);
  }
  :global(html[data-motion='full']) .hero-title {
    --soft: 0;
    --wonk: 1;
  }
  /* split lines are locked: SOFT widens glyphs ~3 %, so never re-wrap (no CLS) */
  .hero-title :global(.line) {
    white-space: nowrap;
  }
  .sig-word {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }
  .sig-stroke {
    position: absolute;
    left: -2%;
    right: -4%;
    bottom: -0.16em;
    height: 0.2em;
    color: var(--ink);
  }
  .sig-stroke :global(svg) {
    width: 100%;
    height: 100%;
  }
  .lede {
    margin-top: 36px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .hero-art {
    margin: 0;
    position: relative;
  }
  @media (min-width: 1024px) {
    .hero-copy,
    .hero-art {
      grid-row: 1;
    }
    .hero-art {
      margin-top: 4%;
    }
  }
  .section-head {
    margin-bottom: clamp(32px, 5vw, 64px);
    row-gap: 12px;
  }
  .approach {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 48px var(--gutter);
    margin-top: 56px;
    padding: 0;
    list-style: none;
  }
  .approach-icon {
    display: block;
    width: 40px;
    margin-bottom: 20px;
  }
  .approach h3 {
    margin-bottom: 8px;
  }
  /* on paper-deep, small secondary text uses ink (wash fails AA there) */
  .muted-deep {
    color: var(--ink);
  }
</style>
