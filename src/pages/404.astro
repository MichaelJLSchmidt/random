---
import Base from '../layouts/Base.astro';
import SpotLantern from '../generated/brush/SpotLantern.astro';
import { url } from '../lib/url';
---
<Base title="Not found" page="404">
  <section class="section" data-opening>
    <div class="wrap grid nf">
      <div class="col-text">
        <p class="eyebrow" data-rise>404</p>
        <h1 data-split>Lost the thread.</h1>
        <p class="lede" data-rise>This page does not exist, or it moved. The lantern still works.</p>
        <p data-rise class="nf-actions">
          <a class="btn" href={url()}>Back to the start</a>
          <a class="btn btn--quiet" href={url('work/')}>See the work</a>
        </p>
      </div>
      <figure class="col-art lantern">
        <SpotLantern anim="load" />
      </figure>
    </div>
  </section>
</Base>
<style>
  .nf {
    align-items: center;
    row-gap: 32px;
  }
  .nf .lede {
    margin-top: 24px;
  }
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .lantern {
    margin: 0;
    width: min(100%, 300px);
    justify-self: center;
  }
</style>
