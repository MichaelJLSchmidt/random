---
import Base from '../layouts/Base.astro';
import Seal from '../components/Seal.astro';
import BrushUnderline from '../generated/brush/BrushUnderline.astro';
import SpotPlane from '../generated/brush/SpotPlane.astro';
import { contact, site } from '../config/site';
---
<Base title="Contact" page="contact" sealPage>
  <section class="section contact-open" data-opening data-contact>
    <div class="wrap grid">
      <div class="col-wide contact-head">
        <h1 class="display say" data-split>{contact.headline}</h1>
        <Seal class="contact-seal" size="clamp(56px, 8vw, 104px)" label="Seal" data-stamp />
      </div>
      <div class="col-text contact-body">
        <p class="lede" data-rise>{contact.body}</p>
        <p class="email-row" data-rise>
          <a class="email" href={`mailto:${site.email}`} data-email={site.email}>
            {site.email}
            <span class="email-stroke" aria-hidden="true"><BrushUnderline anim="manual" decorative idPrefix="email-ul" /></span>
          </a>
        </p>
        <div class="copy-row" data-rise>
          <button class="btn" type="button" data-copy>Copy address</button>
          <p class="copy-status" role="status" aria-live="polite" data-copy-status>
            <span class="copy-icon" aria-hidden="true"></span>
            <span data-msg></span>
            <Seal class="copy-seal" size="22px" data-copy-seal />
          </p>
        </div>
        <ul class="caption elsewhere" data-rise>
          {site.social.map((s) => <li><a class="ink-link" href={s.href} rel="noopener">{s.label}</a></li>)}
          <li>{contact.availability}</li>
        </ul>
      </div>
      <figure class="col-art plane">
        <SpotPlane anim="load" />
      </figure>
    </div>
  </section>
</Base>

<style>
  .contact-open {
    padding-top: clamp(24px, 4vw, 64px);
  }
  .contact-head {
    display: flex;
    align-items: flex-start;
    gap: clamp(16px, 2.5vw, 32px);
  }
  .say {
    font-size: clamp(4rem, 13vw, 12rem);
    line-height: 0.9;
  }
  .contact-seal {
    margin-top: 0.4em;
    visibility: hidden;
  }
  :global(html[data-motion='still']) .contact-seal {
    visibility: visible;
  }
  .contact-body {
    margin-top: 48px;
  }
  .email-row {
    margin-top: 40px;
  }
  .email {
    position: relative;
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 3rem);
    line-height: 1.2;
    color: var(--ink);
    letter-spacing: -0.01em;
    word-break: break-word;
  }
  .email-stroke {
    position: absolute;
    left: -1%;
    right: -1%;
    bottom: -0.18em;
    height: 0.26em;
  }
  .email-stroke :global(svg) {
    width: 100%;
    height: 100%;
  }
  .email-stroke :global(.bs) {
    fill: var(--indigo);
  }
  .copy-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 32px;
  }
  .copy-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 24px;
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
  }
  .copy-status[data-state='error'] {
    color: var(--seal-text);
  }
  .copy-status[data-state='error'] .copy-icon::before {
    content: '!';
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    font-weight: 700;
  }
  .copy-seal {
    visibility: hidden;
  }
  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 48px;
    padding: 0;
    list-style: none;
  }
  .plane {
    margin: 0;
    width: min(100%, 300px);
    justify-self: end;
    align-self: end;
  }
  @media (min-width: 1024px) {
    .plane {
      grid-column: 9 / -1;
    }
  }
</style>
