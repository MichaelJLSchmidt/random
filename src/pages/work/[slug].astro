---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Totem from '../../components/Totem.astro';
import Spine from '../../components/Spine.astro';
import LeadThread from '../../generated/brush/LeadThread.astro';
import manifest from '../../generated/brush/manifest.json';
import { team } from '../../config/site';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const items = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return items.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: items[(i + 1) % items.length] } }));
}
const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const threadMeta = manifest.find((m) => m.id === 'thread')!;
const [, , tw, th] = threadMeta.viewBox;
const anchors = (threadMeta.anchors ?? []) as number[][];
---
<Base title={d.title} description={d.summary} page="case">
  <article>
    <header class="section case-open" data-opening>
      <div class="wrap grid">
        <div class="col-text">
          <p class="eyebrow" data-rise><a class="ink-link" href={url('work/')}>Work</a> / Case study</p>
          <h1 class="case-title" data-split>{d.title}</h1>
          <p class="lede" data-rise>{d.summary}</p>
          <dl class="facts" data-rise>
            <div><dt class="caption">Role</dt><dd>{d.role}</dd></div>
            <div><dt class="caption">Timeframe</dt><dd>{d.timeframe}</dd></div>
            <div><dt class="caption">Team</dt><dd>{d.team}</dd></div>
            <div><dt class="caption">Impact</dt><dd>{d.metric.value} {d.metric.label}</dd></div>
          </dl>
        </div>
        <figure class="col-art totem-large">
          <div class="mat ink-grain">
            <Totem name={d.totem} anim="load" data-settle idPrefix="case-totem" />
          </div>
        </figure>
      </div>
    </header>

    <section class="section" aria-labelledby="context-h" style="padding-top:0">
      <div class="wrap grid">
        <h2 id="context-h" class="col-text" data-split>Context</h2>
        <div class="col-text prose" data-rise><Content /></div>
      </div>
    </section>

    <section class="section section--deep" aria-labelledby="process-h">
      <div class="wrap grid">
        <div class="col-narrow process-intro">
          <p class="eyebrow" data-rise>Process</p>
          <h2 id="process-h" data-split>From problem to impact</h2>
        </div>
        <div class="col-wide process-spine">
          <Spine id="process" scrub items={d.process.map((p) => ({ label: p.stage, title: p.title, body: p.body, note: p.note }))} />
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="led-h">
      <div class="wrap grid">
        <div class="col-text">
          <p class="eyebrow" data-rise>Leadership</p>
          <h2 id="led-h" data-split>How I led</h2>
        </div>
        <div class="col-full thread" data-thread data-own>
          <LeadThread anim="manual" decorative />
          <ul class="thread-labels">
            {
              team.map((t, i) => (
                <li
                  data-thread-label
                  style={`left:${((anchors[i]?.[0] ?? 0) / tw) * 100}%;top:${((anchors[i]?.[1] ?? 0) / th) * 100}%`}
                  class="caption"
                >
                  <span>{t}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <ul class="col-text led-list">
          {d.led.map((l) => <li data-rise>{l}</li>)}
        </ul>
      </div>
    </section>

    <section class="section section--deep" aria-labelledby="outcomes-h">
      <div class="wrap grid">
        <h2 id="outcomes-h" class="col-text" data-split>Outcomes</h2>
        <ul class="metrics col-wide">
          {
            d.outcomes.map((o) => (
              <li data-rise>
                <strong>{o.value}</strong>
                <span class="caption-deep">{o.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <nav class="section" aria-label="Next project">
      <div class="wrap grid">
        <a class="next-card col-wide" href={url(`work/${next.id}/`)} data-next-card data-own>
          <span class="next-text">
            <span class="eyebrow">Next project</span>
            <span class="next-title">{next.data.title}</span>
            <span class="caption">{next.data.metric.value} {next.data.metric.label}</span>
          </span>
          <span class="next-totem" aria-hidden="true">
            <span class="next-ghost"><Totem name={next.data.totem} anim="none" decorative idPrefix="next-ghost" /></span>
            <span class="next-ink"><Totem name={next.data.totem} anim="manual" decorative idPrefix="next-totem" /></span>
          </span>
        </a>
      </div>
    </nav>
  </article>
</Base>

<style>
  .case-open {
    padding-top: clamp(24px, 4vw, 64px);
  }
  .case-open .grid {
    align-items: center;
    row-gap: 40px;
  }
  .case-title {
    margin-top: 16px;
    font-size: clamp(2.75rem, 6vw, 6rem);
  }
  .case-open .lede {
    margin-top: 28px;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px var(--gutter);
    margin-top: 40px;
  }
  .facts dd {
    margin: 4px 0 0;
  }
  .totem-large {
    margin: 0;
    width: min(100%, 420px);
    justify-self: center;
  }
  @media (min-width: 1024px) {
    .totem-large {
      grid-column: 8 / 12;
      justify-self: end;
    }
  }
  .prose :global(p) {
    margin-top: 1em;
  }
  .process-intro {
    margin-bottom: 56px;
  }
  .thread {
    position: relative;
    margin-block: 48px 40px;
  }
  .thread-labels {
    position: absolute;
    inset: 0;
    list-style: none;
    padding: 0;
    pointer-events: none;
  }
  .thread-labels li {
    position: absolute;
    transform: translate(-50%, 22px);
    white-space: nowrap;
  }
  .thread-labels li:first-child {
    transform: translate(-25%, 22px);
  }
  .thread-labels li:last-child {
    transform: translate(-80%, 22px);
  }
  .thread-labels li span {
    display: inline-block;
    background: var(--paper);
    padding: 2px 6px;
  }
  @media (max-width: 639px) {
    .thread-labels li {
      font-size: 0.6875rem;
    }
    .thread-labels li:nth-child(even) {
      transform: translate(-50%, -150%);
    }
    .thread-labels li:last-child {
      transform: translate(-88%, 22px);
    }
  }
  .led-list {
    padding-left: 1.1em;
  }
  .led-list li + li {
    margin-top: 12px;
  }
  .caption-deep {
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    color: var(--ink);
  }
  .metrics {
    margin-top: 48px;
  }
  .next-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(120px, 18vw, 220px);
    align-items: center;
    gap: var(--gutter);
    padding: clamp(24px, 4vw, 48px);
    background: var(--paper-deep);
    color: var(--ink);
    border-radius: 2px;
  }
  @media (max-width: 639px) {
    .next-card {
      grid-template-columns: minmax(0, 1fr);
    }
    .next-totem {
      width: 140px;
      justify-self: end;
    }
  }
  .next-totem {
    position: relative;
    display: block;
  }
  .next-ghost {
    display: block;
    opacity: 0.16;
  }
  .next-ghost :global(.bs[data-layer='paint']) {
    display: none;
  }
  .next-ink {
    position: absolute;
    inset: 0;
  }
  .next-text {
    display: grid;
    gap: 12px;
  }
  .next-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    line-height: 1.05;
    letter-spacing: -0.015em;
  }
  .next-card .caption {
    color: var(--ink);
  }
</style>
