---
// Motion tier control: three small brush dots (Full / Calm / Still).
// Native radios: keyboard arrows work, state is announced.
import BrushDot from '../generated/brush/BrushDot.astro';
interface Props {
  name: string;
}
const { name } = Astro.props;
const tiers = [
  { id: 'full', label: 'Full motion' },
  { id: 'calm', label: 'Calm motion' },
  { id: 'still', label: 'No motion' },
];
---
<fieldset class="motion-toggle" data-motion-toggle>
  <legend>Motion</legend>
  {
    tiers.map((t) => (
      <label data-tier={t.id} title={t.label}>
        <input type="radio" name={name} value={t.id} aria-label={t.label} />
        <BrushDot anim="none" decorative idPrefix={`${name}-${t.id}`} />
      </label>
    ))
  }
</fieldset>
