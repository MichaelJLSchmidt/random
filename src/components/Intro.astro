---
// First visit per session (Full tier only): an overlay over the server-
// rendered page. Paper fades in, the wordmark draws, the seal stamps, then
// the word FLIPs into the nav logo. ≤ 2.4 s, skippable, never a blocker.
import Wordmark from '../generated/brush/Wordmark.astro';
import Seal from './Seal.astro';
---
<div class="intro" data-intro aria-hidden="true">
  <div class="intro-paper ink-grain"></div>
  <div class="intro-mark">
    <Wordmark anim="manual" decorative idPrefix="intro" data-intro-word />
    <Seal data-intro-seal />
  </div>
  <button class="btn btn--quiet intro-skip" type="button" data-intro-skip aria-hidden="false">Skip intro</button>
</div>
