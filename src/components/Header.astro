---
import Wordmark from '../generated/brush/Wordmark.astro';
import MenuOpen from '../generated/brush/MenuOpen.astro';
import MenuClose from '../generated/brush/MenuClose.astro';
import MotionToggle from './MotionToggle.astro';
import { nav, site } from '../config/site';
import { url, isCurrent } from '../lib/url';
const path = Astro.url.pathname;
const items = nav.map((n) => ({ ...n, href: url(n.href), current: isCurrent(url(n.href), path) }));
---
<header class="site-header">
  <div class="wrap">
    <a class="logo" href={url()} aria-label={`${site.wordmark}, home`} data-logo>
      <Wordmark anim="none" decorative idPrefix="logo" />
    </a>
    <nav class="nav" aria-label="Main">
      <ul class="nav-list">
        {
          items.map((n) => (
            <li>
              <a class="nav-link" href={n.href} aria-current={n.current ? 'page' : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
      <MotionToggle name="motion-header" />
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="menu-sheet" data-menu-open>
        <span class="sr-only">Open menu</span>
        <MenuOpen anim="none" decorative idPrefix="menu-open" class="menu-open" />
      </button>
    </nav>
  </div>
  <MenuClose anim="none" decorative idPrefix="menu-x" data-menu-x style="display:none" />
  <div class="menu-sheet" id="menu-sheet" role="dialog" aria-modal="true" aria-label="Menu" data-menu-sheet>
    <nav aria-label="Main (mobile)">
      <ul>
        {
          items.map((n) => (
            <li data-menu-item>
              <a class="nav-link" href={n.href} aria-current={n.current ? 'page' : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div data-menu-item>
      <MotionToggle name="motion-sheet" />
    </div>
  </div>
</header>
