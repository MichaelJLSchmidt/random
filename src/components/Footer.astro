---
import { site, nav } from '../config/site';
import { url } from '../lib/url';
---
<footer class="site-footer">
  <div class="wrap">
    <p class="caption">{site.owner} · {site.role} · {site.location}</p>
    <ul class="caption">
      {nav.map((n) => <li><a class="ink-link" href={url(n.href)}>{n.label}</a></li>)}
    </ul>
    <p class="caption">Set in Fraunces, Instrument Sans and JetBrains Mono. Drawn with the INKWAKE brush system.</p>
  </div>
</footer>
