---
import IconResearch from '../generated/brush/IconResearch.astro';
import IconWorkshop from '../generated/brush/IconWorkshop.astro';
import IconPrototype from '../generated/brush/IconPrototype.astro';
import IconSystems from '../generated/brush/IconSystems.astro';
import IconFacilitation from '../generated/brush/IconFacilitation.astro';
import IconMetrics from '../generated/brush/IconMetrics.astro';
import IconAccess from '../generated/brush/IconAccess.astro';
import IconMentoring from '../generated/brush/IconMentoring.astro';
const map = {
  research: IconResearch,
  workshop: IconWorkshop,
  prototype: IconPrototype,
  systems: IconSystems,
  facilitation: IconFacilitation,
  metrics: IconMetrics,
  access: IconAccess,
  mentoring: IconMentoring,
};
interface Props {
  name: string;
  [key: string]: unknown;
}
const { name, ...rest } = Astro.props;
const C = map[name as keyof typeof map];
---
<C decorative {...rest} />
